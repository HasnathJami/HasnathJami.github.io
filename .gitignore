# ── Dependencies ─────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output ─────────────────────────────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ── Testing & coverage ───────────────────────────────────────────────────
/coverage
/.nyc_output

# ── Environment ──────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# `.env.example` is intentionally tracked as documentation.
!.env.example

# ── Caches & tooling ─────────────────────────────────────────────────────
.eslintcache
.cache/
.turbo/
.vercel
.netlify

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editors ──────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
# Keep shared workspace settings, ignore personal overrides.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
